# Bu dosyayı .env olarak kopyalayıp değerleri kendinize göre düzenleyin.

# Admin panelinin ve yazma endpoint'lerinin (POST/PUT) kullandığı gizli anahtar.
# Admin panelinde giriş yaparken bu değeri girmeniz gerekir.
ADMIN_TOKEN=dev-secret-change-me

# index.html ve admin.html'in servis edileceği origin'ler (virgülle ayırın).
# Örn: python -m http.server 5500 ile proje kökünden çalıştırıyorsanız:
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Bio sayfalarının yayında yaşadığı adres. QR kodları ve admin panelindeki
# "Linki Kopyala" butonu bu adres + /slug şeklinde bir URL üretir.
# Production'da gerçek domain'inizle değiştirin, örn: https://besyildizz.bio
PUBLIC_SITE_URL=http://localhost:5500
